{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc",
    "import"
  ],
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": "warn",
    "react/jsx-key": "error",
    "no-unused-vars": "warn",
    "no-console": "off",
    "react/refs": "off"
  },
  "ignorePatterns": [
    "dist",
    "node_modules"
  ]
}
