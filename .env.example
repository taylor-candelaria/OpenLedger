# Copy this file to .env.local and fill in your own keys.
# These are read by the Vite dev/preview server only (no VITE_ prefix),
# so they are never bundled into the browser code.

# api.data.gov key, used for the data.gov Catalog API on the GSA gateway.
# Sign up: https://api.data.gov/signup/
# Without it, searches use data.gov's public catalog search instead.
DATA_GOV_API_KEY=

# Census Data API key, used for state and local government finance data.
# Sign up: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# SimplyCoding Todo App API class token, used for research notes on the Explore page.
# Generate one on the course's "API Access" lesson (it is shown only once).
SIMPLYCODING_TOKEN=

# Any string that keeps this app's notes apart from classmates' (not a login).
SIMPLYCODING_USER=openledger-taylor
